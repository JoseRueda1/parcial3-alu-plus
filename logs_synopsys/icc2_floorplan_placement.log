./m31/kit/M31LLSC750GL150MS.0.01/milkyway_techfiles/tech/GL150M_5M1T_9K.tf
set GDS_MAP [glob ./m31/kit/*/milkyway_techfiles/map/gds2OutLayer.map]
./m31/kit/M31LLSC750GL150MS.0.01/milkyway_techfiles/map/gds2OutLayer.map
set NETLIST ./run_dc/alu_sync_div_dc.v
./run_dc/alu_sync_div_dc.v
set SDC     ./run_dc/alu_sync_div_dc.sdc
./run_dc/alu_sync_div_dc.sdc
set RPT     ./reports_icc2
./reports_icc2
set OUT     ./out_icc2
./out_icc2
file mkdir $RPT
file mkdir $OUT
proc paso {txt} {
  puts "\n=========================================================="
  puts "== $txt"
  puts "==========================================================\n"
}
# Un reporte que falle no debe detener el flujo
proc reporte {archivo cmd} {
